# ==============================================================================
# FoodWise AI - Environment Variables Configuration
# ==============================================================================
# Copy this file to .env for local development:
# cp .env.example .env

# Security
SECRET_KEY=replace-with-a-random-secure-secret-key-for-production-min-32-chars

# Database Configuration
# In local development: defaults to SQLite (database/app.db) if left blank.
# In production on Vercel: Provide a PostgreSQL connection string (Supabase, Neon, Render, Railway)
# Example: postgresql://username:password@ep-cool-sample.us-east-1.aws.neon.tech/foodwise?sslmode=require
DATABASE_URL=

# Administrative Account Credentials (Initial Seed)
ADMIN_EMAIL=admin@foodwise.ai
ADMIN_PASSWORD=Admin@FoodWise2026!

# Public Demo Account (Initial Seed)
DEMO_PASSWORD=Demo@FoodWise2026!

# Optional: Email Service for Password Reset (SMTP)
# If left blank, password reset returns a testing reset link directly.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

